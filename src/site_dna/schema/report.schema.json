{
  "$defs": {
    "CheckRecord": {
      "description": "Single SEO rule result, scoped to a page or the whole site.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "page",
            "site"
          ],
          "title": "Scope",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "threshold": {
          "default": null,
          "title": "Threshold"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "id",
        "scope",
        "status"
      ],
      "title": "CheckRecord",
      "type": "object"
    },
    "CheckStatus": {
      "description": "Outcome of a single SEO rule or check.",
      "enum": [
        "passed",
        "warning",
        "failed",
        "not_available"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "ColorRecord": {
      "description": "Observed color with ranking metadata (facts only).",
      "properties": {
        "hex": {
          "title": "Hex",
          "type": "string"
        },
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "weight": {
          "default": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "share": {
          "default": 0.0,
          "title": "Share",
          "type": "number"
        },
        "usages": {
          "$ref": "#/$defs/ColorUsage"
        },
        "source": {
          "const": "computed",
          "default": "computed",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "hex"
      ],
      "title": "ColorRecord",
      "type": "object"
    },
    "ColorRoleRecord": {
      "description": "Heuristically assigned color role (inferred, not a fact).",
