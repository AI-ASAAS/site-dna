        "source": {
          "const": "inferred",
          "default": "inferred",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "hex"
      ],
      "title": "ColorRoleRecord",
      "type": "object"
    },
    "ColorRoles": {
      "description": "Role assignments derived from the observed color palette.",
      "properties": {
        "background": {
          "items": {
            "$ref": "#/$defs/ColorRoleRecord"
