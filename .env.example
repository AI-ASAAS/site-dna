APP_NAME="Site DNA"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
VISUAL_ANALYSIS_MODEL=gemini-3.6-flash
UX_ANALYSIS_MODEL=gemini-3.6-flash
CONTENT_ANALYSIS_MODEL=gemini-3.6-flash
TECHNICAL_SEO_MODEL=gemini-3.6-flash
UX_ANALYSIS_ENABLED=true
CONTENT_ANALYSIS_ENABLED=true
TECHNICAL_SEO_ENABLED=true
LOG_LEVEL=INFO
ENABLE_LIVE_LLM_TESTS=false

# Website Intelligence MVP (Phases 1-9)
# Optional; PSI also works unauthenticated at a lower quota.
PSI_API_KEY=
STORAGE_DIR=storage
ALLOW_PRIVATE_HOSTS=false
SCAN_MAX_PAGES=20
SCAN_MAX_DEPTH=2
SCAN_MAX_BROKEN_LINK_CHECKS=200
SCAN_REQUEST_TIMEOUT_SECONDS=20
SCAN_PAGE_TIMEOUT_SECONDS=45
SCAN_PSI_TIMEOUT_SECONDS=90
SCAN_PER_HOST_RPS=2
SCAN_MAX_TOTAL_SECONDS=300
VISUAL_ANALYSIS_API_ENABLED=true
DISCOVERY_API_ENABLED=true
TECHNICAL_SEO_API_ENABLED=true
COMPETITOR_ANALYSIS_ENABLED=true
COMPETITOR_ANALYSIS_MODEL=gemini-3.6-flash
SECURITY_ANALYSIS_ENABLED=true
SECURITY_ANALYSIS_MODEL=gemini-3.6-flash
ACCESSIBILITY_ANALYSIS_ENABLED=true
ACCESSIBILITY_ANALYSIS_MODEL=gemini-3.6-flash
ACCESSIBILITY_MAX_PAGES=8
ACCESSIBILITY_MAX_MODEL_CALLS=3
ACCESSIBILITY_MAX_RECOMMENDATIONS=12
ACCESSIBILITY_CACHE_ENABLED=true
ACCESSIBILITY_REQUIRE_AI=true
ACCESSIBILITY_AUTOMATED_RULES_ENABLED=true
